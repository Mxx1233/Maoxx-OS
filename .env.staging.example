POSTGRES_DB=maoxx_staging_example
POSTGRES_USER=maoxx_staging_example
POSTGRES_PASSWORD=replace-with-a-unique-staging-password
DATABASE_URL=postgresql+psycopg://maoxx_staging_example:replace-with-a-unique-staging-password@db:5432/maoxx_staging_example
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
APP_ENV=staging
APP_TIMEZONE=Europe/Berlin
LOCAL_STORAGE_ROOT=/app/storage
FEISHU_APP_ID=disabled-for-staging
FEISHU_APP_SECRET=disabled-for-staging
